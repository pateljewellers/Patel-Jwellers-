                <div class="heritage-back-totem" id="heritage-back-totem" aria-label="Return to Curated Categories">
                  <div class="totem-aura"></div>
                  <div class="totem-sculpture">
                    <svg class="totem-svg" viewBox="0 0 200 200">
                      <!-- Circular Rotating Label -->
                      <path id="textPath-circle" d="M 100, 100 m -62, 0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" fill="none"></path>
                      <text class="totem-orbit-text">
                        <textPath href="#textPath-circle" startOffset="0%">• RETURN TO CATEGORIES • BACK TO GALLERY •</textPath>
                      </text>
                      
                      <!-- Outer Octagon Frame -->
                      <polygon class="totem-octagon" points="100,38 144,56 162,100 144,144 100,162 56,144 38,100 56,56" fill="none"></polygon>
                      
                      <!-- Sacred Geometry Triangles (Merkaba Lines) -->
                      <polygon class="totem-triangles-1" points="100,50 143,125 57,125" fill="none"></polygon>
                      <polygon class="totem-triangles-2" points="100,150 143,75 57,75" fill="none"></polygon>
                      
                      <!-- Faceted Rhombus Core -->
                      <polygon class="totem-rhombus-core" points="100,68 127,100 100,132 73,100"></polygon>
                      
                      <!-- Vortex Chevron Arrow -->
                      <path class="totem-chevron" d="M 94,94 L 86,100 L 94,106 M 86,100 L 114,100" fill="none"></path>
                    </svg>
                    <span class="totem-sub-label">RETURN TO GALLERY</span>
