<%- include('../partials/layout-start') %>
  <%- include('../partials/header') %>

    <main class="main-content page-heritage-jewellery">

      <!-- 1. Fullscreen Hero Section with background and curtain overlay -->
      <section class="heritage-hero-section">


        <!-- Unveiled Background Image -->
