                  </div>
                </div>

                <!-- Snappy Unveil Button -->
                <button class="curtain-unveil-btn" id="curtain-unveil-trigger" aria-label="Unveil Heritage Details">
                  <span class="btn-shine-line"></span>
                  <span class="btn-text">UNVEIL HERITAGE</span>
