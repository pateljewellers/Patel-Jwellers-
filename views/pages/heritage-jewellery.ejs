    <!-- Custom GSAP & Text Slider Scripts for Page-Specific Motion -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const unveilBtn = document.getElementById('curtain-unveil-trigger');
        const curtain = document.getElementById('heritage-curtain');
        const heroSection = document.querySelector('.heritage-hero-section');
        const contentSection = document.getElementById('heritage-content');
        const slider = document.getElementById('curtain-slider');
        const backTotem = document.getElementById('heritage-back-totem');

        if (!curtain || !unveilBtn) return;

        // ─── SPIN-WHEEL PAGE TRANSITION ───────────────────────────────────────────
        if (backTotem) {
          backTotem.addEventListener('click', () => {
            // Inject the mandala-wheel overlay
            const overlay = document.createElement('div');
            overlay.id = 'spin-exit-overlay';
            overlay.innerHTML = `
              <div class="seo-wheel">
                <div class="seo-ring seo-r1"></div>
                <div class="seo-ring seo-r2"></div>
                <div class="seo-ring seo-r3"></div>
                <div class="seo-ring seo-r4"></div>
                <div class="seo-spokes">
                  <div class="seo-spoke"></div>
                  <div class="seo-spoke"></div>
                  <div class="seo-spoke"></div>
                  <div class="seo-spoke"></div>
                  <div class="seo-spoke"></div>
                  <div class="seo-spoke"></div>
                </div>
                <div class="seo-hub"></div>
              </div>
            `;
            document.body.appendChild(overlay);

            // Also spin the page content out
            const mainEl = document.querySelector('main');
            if (mainEl) mainEl.classList.add('page-spin-exit');

            // Trigger animations on next frame
            requestAnimationFrame(() => {
              requestAnimationFrame(() => overlay.classList.add('active'));
            });

            // Navigate after the spin completes straight to the luxury categories
            setTimeout(() => {
              window.location.href = '/collection#curated-luxury-categories';
            }, 950);
          });

          // ─── 3D PARALLAX TILT FOR BACK TOTEM ────────────────────────────────────
          backTotem.addEventListener('mousemove', (e) => {
            const rect = backTotem.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const xc = (x / rect.width - 0.5) * 2; // range [-1, 1]
            const yc = (y / rect.height - 0.5) * 2; // range [-1, 1]

            // Totem levitation & tilt
            backTotem.style.transform = `perspective(1000px) rotateX(${yc * 12}deg) rotateY(${xc * -12}deg) translateY(-8px)`;
            
            // Core crystal deeper 3D parallax shift
            const core = backTotem.querySelector('.totem-rhombus-core');
            const chevron = backTotem.querySelector('.totem-chevron');
            if (core) {
              core.style.transform = `translate(${xc * 6}px, ${yc * 6}px)`;
            }
            if (chevron) {
              chevron.style.transform = `translate(${xc * 9}px, ${yc * 9}px)`;
            }
          });

          backTotem.addEventListener('mouseleave', () => {
            backTotem.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)';
            const core = backTotem.querySelector('.totem-rhombus-core');
            const chevron = backTotem.querySelector('.totem-chevron');
            if (core) {
              core.style.transform = 'none';
            }
            if (chevron) {
              chevron.style.transform = 'none';
            }
          });
        }

        // ─── SCROLL LOCK ────────────────────────────────────────────────────────────
        // Prevent ALL scrolling until the user explicitly clicks "Unveil Heritage".
        // We lock both html and body and also swallow wheel / touch-move events.
        let scrollLocked = true;

        const lockScroll = () => {
          document.documentElement.style.overflow = 'hidden';
          document.body.style.overflow = 'hidden';
        };

        const unlockScroll = () => {
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
          scrollLocked = false;
        };

        // Swallow wheel and touchmove while locked so inertia scrolling is blocked too
        const blockWheel = (e) => { if (scrollLocked) e.preventDefault(); };
        const blockTouch = (e) => { if (scrollLocked) e.preventDefault(); };

        lockScroll();
        window.addEventListener('wheel', blockWheel, { passive: false });
        window.addEventListener('touchmove', blockTouch, { passive: false });

        // ─── AUTOMATIC TEXT FADE SLIDER ─────────────────────────────────────────────
        if (slider) {
          const slides = Array.from(slider.querySelectorAll('.slider-slide'));
          let activeIdx = 0;

          setInterval(() => {
            slides[activeIdx].classList.remove('active');
            activeIdx = (activeIdx + 1) % slides.length;
            slides[activeIdx].classList.add('active');
          }, 4000);
        }

        // ─── CURTAIN-LIFTING REVEAL ANIMATION ───────────────────────────────────────
        unveilBtn.addEventListener('click', () => {
          // 1. Lift the curtain overlay
          curtain.classList.add('lifted');

          // 2. Scale and brighten the main background image
          heroSection.classList.add('revealed');

          // 3. Unlock scrolling — do this immediately so the user can scroll down
          unlockScroll();

          // 4. Remove the initial passive-block listeners (no longer needed)
          window.removeEventListener('wheel', blockWheel);
          window.removeEventListener('touchmove', blockTouch);

          // 5. Disclose the content section below
          contentSection.classList.add('revealed');

          // 6. Gently nudge the viewport to the content after the curtain animation
          setTimeout(() => {
            contentSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 900);

          // 7. Settle reveal staggers using GSAP
          if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
            setTimeout(() => {
              ScrollTrigger.refresh();
              const reveals = contentSection.querySelectorAll('.reveal-up');
              reveals.forEach((el) => {
                gsap.fromTo(el,
                  { y: 50, opacity: 0 },
                  {
                    y: 0,
                    opacity: 1,
                    duration: 1.0,
                    ease: 'power3.out',
                    scrollTrigger: {
                      trigger: el,
                      start: 'top 85%',
                      end: 'bottom 20%',
                      toggleActions: 'play none none none'
                    }
                  }
                );
              });
            }, 300);
          }

          // 8. ─── SHUTTER RE-CLOSE ON SCROLL-BACK-TO-TOP ───────────────────────────
          // After unveil, watch for the user scrolling back to the very top.
          // When they do, slide the curtain back down like a shutter and re-lock scroll.
          let shutterPending = false;

          const onScrollBack = () => {
            // Only trigger when fully back at the top and shutter not already closing
            if (window.scrollY <= 0 && !shutterPending) {
              shutterPending = true;

              // Small delay so snap-scrolling inertia settles first
              setTimeout(() => {
                if (window.scrollY > 0) {
                  // User scrolled away again during the delay — abort
                  shutterPending = false;
                  return;
                }

                // ── Close the shutter ──
                curtain.classList.remove('lifted');         // curtain slides back down
                heroSection.classList.remove('revealed');   // image dims back
                contentSection.classList.remove('revealed');// content hides

                // Re-lock scroll immediately
                lockScroll();
                scrollLocked = true;

                // Re-attach the wheel/touch blockers
                window.addEventListener('wheel', blockWheel, { passive: false });
                window.addEventListener('touchmove', blockTouch, { passive: false });

                // Stop watching scroll — will be re-attached on next unveil click
                window.removeEventListener('scroll', onScrollBack);

                // Allow the button to be clicked again after curtain closes
                setTimeout(() => { shutterPending = false; }, 1800);
              }, 80);
            }
          };

          // Start watching — attach after a short delay so the initial smooth-scroll
          // nudge (step 6) doesn't accidentally trigger the shutter immediately
          setTimeout(() => {
            window.addEventListener('scroll', onScrollBack, { passive: true });
          }, 1200);

          // Re-clicking unveil after shutter closes: re-attach the scroll watcher
          unveilBtn.addEventListener('click', function reUnveil() {
            setTimeout(() => {
              window.addEventListener('scroll', onScrollBack, { passive: true });
            }, 1200);
          });
        });

        // ─── 3D LEVITATING TILT FOR GALLERY CARDS ───────────────────────────────────
        const galleryCards = document.querySelectorAll('.gallery-card');
        galleryCards.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const xc = (x / rect.width - 0.5) * 2;
            const yc = (y / rect.height - 0.5) * 2;

            const rotX = -yc * 6;
            const rotY = xc * 6;

            card.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-8px)`;
            card.style.transition = 'none';
          });

          card.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)';
            card.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
          });
        });
      });
    </script>

