          <div class="curtain-structural-corners">
            <div class="curtain-corner tl"></div>
            <div class="curtain-corner tr"></div>
            <div class="curtain-corner bl"></div>
            <div class="curtain-corner br"></div>
          </div>

          <div class="curtain-content">
            <div class="heritage-curtain-container">
              <!-- Left Column: Editorial Text & Unveil Button -->
              <div class="curtain-editorial-left">
                <!-- Automatic Text Slider -->
                <div class="curtain-text-slider" id="curtain-slider">
                  <div class="slider-slide active">
                    <span class="slider-eyebrow">THE GRAND LEGACY</span>
                    <h2 class="slider-title">Bridal Heritage Collection</h2>
                    <p class="slider-desc">A poetic synthesis of BIS-hallmarked 22K gold, hand-cut diamonds, and heritage
                      filigree passed down through generations.</p>
                  </div>
                  <div class="slider-slide">
                    <span class="slider-eyebrow">HEIRLOOM CRAFT</span>
                    <h2 class="slider-title">Master Goldsmith Sculpting</h2>
                    <p class="slider-desc">Observe the divine temple artistry and light-reflective polish hand-finished by
                      master artisans with ancestral tools.</p>
                  </div>
                  <div class="slider-slide">
                    <span class="slider-eyebrow">SACRED SYMMETRY</span>
                    <h2 class="slider-title">Exquisite Wedding Ensembles</h2>
                    <p class="slider-desc">Luminous, balanced bridal statement chokers, necklaces and payals custom-crafted
