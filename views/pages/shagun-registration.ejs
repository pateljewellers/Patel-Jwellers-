  <section class="section page-hero premium-shagun-hero">
    <div class="hero-particles-container" id="hero-particles"></div>
    <div class="hero-overlay-glow"></div>
    
    <div class="container hero-split-container">
      
      <div class="hero-visual-3d">
        <div class="shagun-card-3d-wrapper">
          <div class="shagun-card-3d-front">
            <div class="gold-filigree-border"></div>
            <div class="brand-logo-stamp">
              <img src="/images/logo/logo.png?v=2.2" alt="Patel Jewellers" class="hero-stamp-img">
            </div>
            <div class="shagun-card-text">
              <span class="card-tag">BRIDAL REGISTRY</span>
              <h3 class="card-year">2026</h3>
            </div>
