      <section class="section shagun-registration">
        <div class="shagun-registration__wrapper">
          <div class="container">
            <div class="shagun-registration__header">
              <span class="section-eyebrow">REGISTRATION</span>
              <h2 class="shagun-section-title">Shagun 2026</h2>

            </div>

            <div class="shagun-progress" aria-label="Registration steps">
              <div class="shagun-progress__item is-active" role="listitem" data-step="1">
                <strong>Step 1</strong>
                Personal
              </div>
              <div class="shagun-progress__item is-complete" role="listitem" data-step="2">
                <strong>Step 2</strong>
                Wedding
              </div>
              <div class="shagun-progress__item" role="listitem" data-step="3">
                <strong>Step 3</strong>
                Documents
              </div>
            </div>

            <form id="shagun-registration-form" class="shagun-form" novalidate>
              <div class="shagun-form-step" data-step="0">
                <div class="form-card">
                  <div class="form-group">
                    <label class="form-label" for="brideName">Bride's full name</label>
                    <input class="form-control" type="text" id="brideName" name="brideName" data-required="true"
                      placeholder="Enter full name">
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="mobileNumber">Mobile number</label>
                    <input class="form-control" type="tel" id="mobileNumber" name="mobileNumber" data-required="true"
                      placeholder="Enter mobile number">
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="dateOfBirth">Date of birth</label>
                    <input class="form-control" type="date" id="dateOfBirth" name="dateOfBirth" data-required="true">
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="fullAddress">Full address</label>
                    <textarea class="form-control" id="fullAddress" name="fullAddress" data-required="true" rows="4"
                      placeholder="Enter address"></textarea>
                  </div>
                  <div class="form-row two-col">
                    <div class="form-group">
                      <label class="form-label" for="pinCode">PIN code</label>
                      <input class="form-control" type="text" id="pinCode" name="pinCode" data-required="true"
                        placeholder="PIN code">
                    </div>
                    <div class="form-group">
                      <label class="form-label" for="city">City</label>
                      <input class="form-control" type="text" id="city" name="city" data-required="true"
                        placeholder="City">
                    </div>
                  </div>
                </div>
                <div class="shagun-form-actions">
                  <button class="btn btn--outline" data-action="next-step">Continue</button>
                </div>
              </div>

              <div class="shagun-form-step" data-step="1">
                <div class="form-card">
                  <div class="form-group">
                    <label class="form-label" for="weddingDate">Wedding date</label>
                    <input class="form-control" type="date" id="weddingDate" name="weddingDate" data-required="true">
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="weddingVenue">Wedding venue</label>
                    <input class="form-control" type="text" id="weddingVenue" name="weddingVenue" data-required="true"
                      placeholder="Venue name or address">
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="referenceName">Reference name (optional)</label>
                    <input class="form-control" type="text" id="referenceName" name="referenceName"
                      placeholder="Who referred you?">
                  </div>
                </div>
                <div class="shagun-form-actions">
                  <button class="btn btn--outline" data-action="prev-step">Back</button>
                  <button class="btn btn--primary" data-action="next-step">Continue</button>
                </div>
              </div>

              <div class="shagun-form-step" data-step="2">
                <div class="form-card">
                  <div class="form-group">
                    <label class="form-label">Identity proof</label>
                    <div class="radio-group">
                      <label class="radio-field">
                        <input type="radio" name="identityProofType" value="Aadhar card" checked>
                        Aadhar card
                      </label>
                      <label class="radio-field">
                        <input type="radio" name="identityProofType" value="Voter ID">
                        Voter ID
                      </label>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="identityProof">Upload identity document</label>
                    <div class="file-upload">
                      <input class="form-control" type="file" id="identityProof" name="identityProof"
                        accept="image/*,.pdf">
                      <p>Choose JPG, PNG, WebP or PDF up to 5 MB.</p>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Wedding proof</label>
                    <div class="radio-group">
                      <label class="radio-field">
                        <input type="radio" name="weddingProofType" value="Venue booking receipt" checked>
                        Venue booking receipt
                      </label>
                      <label class="radio-field">
                        <input type="radio" name="weddingProofType" value="Wedding invitation card">
                        Wedding invitation card
                      </label>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="weddingProof">Upload wedding proof</label>
                    <div class="file-upload">
                      <input class="form-control" type="file" id="weddingProof" name="weddingProof"
                        accept="image/*,.pdf">
                      <p>Choose JPG, PNG, WebP or PDF up to 5 MB.</p>
                    </div>
                  </div>
                  <div class="terms-card">
                    <h3>Terms & Conditions</h3>
                    <div class="terms-text">
                      <p>1. Eligibility: Exclusively for brides whose weddings are scheduled during the upcoming season.
                        All details must be accurate and complete.</p>
                      <p>2. Mandatory Registration: Online registration is required to reserve Shagun consultation and
                        bridal privileges.</p>
                      <p>3. Verification: Aadhar or approved identity proof and wedding proof must be provided for
                        registration approval.</p>
                      <p>4. Privacy: Your information is handled securely and only used for registration and
                        consultation.</p>
                    </div>
                    <label class="form-group" style="margin-top: var(--space-lg);">
                      <input type="checkbox" id="agreeTerms" name="agreeTerms" data-required="true"
                        style="margin-right: 0.75rem;">
                      I agree to the Terms & Conditions
                    </label>
                  </div>
                </div>
                <div class="shagun-form-actions">
                  <button class="btn btn--outline" data-action="prev-step">Back</button>
                  <button class="btn btn--primary" type="submit">Submit registration</button>
                </div>
                <p class="shagun-submit-note" id="shagun-submit-note"></p>
              </div>
            </form>
          </div>
        </div>
      </section>
