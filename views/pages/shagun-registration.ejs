      <section class="section shagun-registration scroll-section" id="shagun-registration-section" aria-labelledby="registration-heading">
        <!-- Interactive Gold Dust and Star Canvas Backdrop -->
        <canvas class="contact-canvas" id="shagun-registration-canvas" aria-hidden="true"></canvas>

        <!-- Ambient Radial Glow and Stencil Pattern -->
        <div class="contact-ambient-glow" aria-hidden="true"></div>
        <div class="contact-jaali-wrap" aria-hidden="true">
          <div class="contact-jaali"></div>
        </div>

        <div class="container shagun-registration__wrapper">
          <header class="section-header reveal-blur text-center" style="margin-bottom: 50px;">
            <span class="section-eyebrow">REGISTRATION</span>
            <h2 id="registration-heading" class="shagun-section-title">Shagun 2026</h2>
          </header>

          <!-- Unified Symmetrical 3D Horizontal Luxury Console -->
          <div class="contact-luxury-console reveal-scale" id="shagun-registration-console">
            <!-- Outer Double Border Ornaments -->
            <div class="console-brass-filigree filigree--top-left" aria-hidden="true"></div>
            <div class="console-brass-filigree filigree--top-right" aria-hidden="true"></div>
            <div class="console-brass-filigree filigree--bottom-left" aria-hidden="true"></div>
            <div class="console-brass-filigree filigree--bottom-right" aria-hidden="true"></div>
            
            <!-- Spotlight shine coordinates -->
            <div class="console-spotlight" aria-hidden="true"></div>

            <!-- Inner Double Border Spacer Grid -->
            <div class="console-inner-frame">
              
              <!-- Left Column: Branding & Symmetrical Concierge Info -->
              <div class="console-brand-side">
                <!-- Transparent Gujarati flourish-free Logo -->
                <div class="concierge-logo-wrap" aria-hidden="true" style="margin-bottom: 30px;">
                  <img src="/images/logo/shagun-logo.png" alt="Pahalu Shagun logo" class="concierge-logo-img" style="filter: none; max-width: 230px; width: 100%; height: auto; display: block; margin: 0 auto;">
                </div>

                <h3 class="concierge-title">Shagun Bridal</h3>
                <span class="concierge-subtitle">Exclusive Privileges</span>
                <p class="concierge-lead">Your noble wedding journey deserves an extraordinary beginning. Register to co-create your bespoke bridal and signature creations with priority consultations and seasonal gift privileges.</p>

                <div class="concierge-details">
                  <div class="concierge-item">
                    <span class="concierge-label">Bridal Privilege Gift</span>
                    <p class="concierge-text">Exclusive Shagun Kit</p>
                  </div>
                  
                  <div class="concierge-hairline" aria-hidden="true"></div>

                  <div class="concierge-item">
                    <span class="concierge-label">Priority Sanctuary</span>
                    <p class="concierge-text">VIP Suite Styling Lounge</p>
                  </div>

                  <div class="concierge-hairline" aria-hidden="true"></div>

                  <div class="concierge-item">
                    <span class="concierge-label">Bespoke Design Desk</span>
                    <p class="concierge-text">Direct with Master Artisans</p>
                  </div>
                </div>
              </div>

              <!-- Symmetrical Gold Vertical Separator Rule -->
              <div class="console-divider-vertical" aria-hidden="true"></div>

              <!-- Right Column: Symmetrical Calligraphy Multi-Step Inquiry Desk -->
              <div class="console-form-side">
                <form id="shagun-registration-form" class="shagun-form-premium" novalidate>
                  <h4 class="form-title-desk" style="margin-bottom: 12px; font-weight: 500;">Shagun <span class="gold-gradient-text">2026</span></h4>
                  <p class="form-subtitle-desk" style="margin-bottom: 30px; font-size: 0.88rem; color: rgba(42, 42, 42, 0.6); line-height: 1.5;">Share your details, wedding dates, and identity proofs with our luxury styling team to complete your Shagun registration.</p>
                  
                  <!-- Form Progress Indicator -->
                  <div class="shagun-progress" aria-label="Registration steps" style="margin-bottom: 30px;">
                    <div class="shagun-progress__item is-active" data-step="1">
                      <strong>Step 1</strong> Personal
                    </div>
                    <div class="shagun-progress__item" data-step="2">
                      <strong>Step 2</strong> Wedding
                    </div>
                    <div class="shagun-progress__item" data-step="3">
                      <strong>Step 3</strong> Documents
                    </div>
                  </div>

                  <!-- Step 1: Personal Details -->
                  <div class="shagun-form-step is-active" data-step="0">
                    <div class="form-group-premium">
                      <input type="text" id="brideName" name="brideName" class="form-input-premium" required placeholder=" " autocomplete="name" data-required="true">
                      <label for="brideName" class="form-label-premium">Bride's Noble Name</label>
                      <span class="focus-line-glow" aria-hidden="true"></span>
                    </div>

                    <div class="form-group-premium">
                      <input type="tel" id="mobileNumber" name="mobileNumber" class="form-input-premium" required placeholder=" " autocomplete="tel" data-required="true">
                      <label for="mobileNumber" class="form-label-premium">Mobile Number</label>
                      <span class="focus-line-glow" aria-hidden="true"></span>
                    </div>

                    <div class="form-group-premium date-group">
                      <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-input-premium" required data-required="true" placeholder=" ">
                      <label for="dateOfBirth" class="form-label-premium">Date of Birth</label>
                      <span class="focus-line-glow" aria-hidden="true"></span>
                    </div>

                    <div class="form-group-premium textarea-group">
                      <textarea id="fullAddress" name="fullAddress" class="form-input-premium form-textarea-premium" required rows="3" placeholder=" " data-required="true"></textarea>
                      <label for="fullAddress" class="form-label-premium">Boutique Delivery Address</label>
                      <span class="focus-line-glow" aria-hidden="true"></span>
                    </div>

                    <div class="form-row two-col" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
                      <div class="form-group-premium">
                        <input type="text" id="pinCode" name="pinCode" class="form-input-premium" required placeholder=" " data-required="true">
                        <label for="pinCode" class="form-label-premium">PIN Code</label>
                        <span class="focus-line-glow" aria-hidden="true"></span>
                      </div>
                      <div class="form-group-premium">
                        <input type="text" id="city" name="city" class="form-input-premium" required placeholder=" " data-required="true">
                        <label for="city" class="form-label-premium">City</label>
                        <span class="focus-line-glow" aria-hidden="true"></span>
                      </div>
                    </div>

                    <div class="shagun-form-actions" style="margin-top: 30px; display: flex; justify-content: flex-end; gap: 15px;">
                      <button class="btn btn--primary btn--magnetic contact-submit-btn btn-next-premium" data-action="next-step" style="border-radius: 50px;">
