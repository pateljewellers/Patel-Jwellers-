<section class="section home-collections" id="collections">
  <div class="container">
    <header class="section-header reveal-up">
      <span class="section-eyebrow">Curated For You</span>
      <h2>Featured Collections</h2>
      <p>Discover our signature ranges — each crafted with hallmark purity and timeless design.</p>
    </header>
    <div class="collections-grid">
      <% home.collections.forEach(function(col, i) { %>
        <a href="<%= col.href %>" class="collection-card reveal-up" style="--delay: <%= i * 80 %>ms">
          <div class="collection-card__img-wrap">
            <img src="<%= col.image %>" alt="<%= col.title %> collection" loading="lazy" width="400" height="500">
            <div class="collection-card__overlay"></div>
          </div>
          <div class="collection-card__body">
            <h3><%= col.title %></h3>
            <span class="collection-card__link">Explore <span aria-hidden="true">→</span></span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
