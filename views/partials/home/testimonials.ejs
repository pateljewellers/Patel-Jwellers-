<section class="section home-testimonials" id="testimonials">
  <div class="container">
    <header class="section-header reveal-up">
      <span class="section-eyebrow"><%= home.testimonials.eyebrow %></span>
      <h2><%= home.testimonials.title %></h2>
    </header>
    <div class="testimonials-slider" id="testimonials-slider">
      <div class="testimonials-track">
        <% home.testimonials.items.forEach(function(t, i) { %>
          <blockquote class="testimonial-card reveal-up" style="--delay: <%= i * 120 %>ms">
            <div class="testimonial-card__stars" aria-hidden="true">★★★★★</div>
            <p class="testimonial-card__quote">"<%= t.quote %>"</p>
            <footer>
              <cite><%= t.name %></cite>
              <span><%= t.role %></span>
            </footer>
          </blockquote>
        <% }); %>
      </div>
    </div>
  </div>
</section>
