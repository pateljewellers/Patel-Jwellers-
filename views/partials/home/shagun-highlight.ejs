<section class="section home-shagun" id="shagun">
  <div class="container home-shagun__inner">
    <div class="home-shagun__content reveal-up">
      <span class="section-eyebrow section-eyebrow--light"><%= home.shagun.eyebrow %></span>
      <h2><%= home.shagun.title %></h2>
      <p class="home-shagun__desc"><%= home.shagun.description %></p>
      <a href="<%= home.shagun.cta.href %>" class="btn btn--primary btn--magnetic"><%= home.shagun.cta.label %></a>
    </div>
    <div class="home-shagun__media reveal-up reveal-delay-2">
      <img src="<%= home.shagun.image %>" alt="Bridal Shagun Registration" loading="lazy" width="520" height="620">
    </div>
  </div>
</section>
