<section class="home-gallery scroll-section" id="signature-gallery">
  <div class="gallery-sticky-wrapper">
    <!-- Subtle luxury gold orb background overlay -->
    <div class="gallery-ambient" aria-hidden="true">
      <div class="gallery-orb gallery-orb--dark-gold"></div>
    </div>

    <div class="container">
      <!-- Header with animated kinetic word titles -->
      <header class="gallery-header">
        <div class="gallery-eyebrow-wrap reveal-up">
          <span class="gallery-eyebrow"><%= home.gallery.eyebrow %></span>
          <span class="gallery-eyebrow__line" aria-hidden="true"></span>
        </div>

        <h2 class="gallery-title reveal-up reveal-delay-1" id="gallery-3d-title">
          <span class="gallery-word-wrap"><em class="gallery-word" style="display: inline-block;">Signature</em></span>
          <span class="gallery-word-wrap gallery-word-wrap--gold"><em class="gallery-word" style="display: inline-block;">Creations</em></span>
        </h2>
        <p class="gallery-subtitle reveal-up reveal-delay-1"><%= home.gallery.subtitle %></p>
      </header>

      <!-- The Big Rectangle Screen with Scrollable Image -->
      <div class="gallery-big-screen" aria-label="Signature Masterpiece Display Screen">
        <div class="gallery-scrollable-image-container">
          <img src="/images/signature-scroll.jpg" class="gallery-scrollable-image" alt="Signature Masterpieces Showcase">
        </div>
        <div class="gallery-screen-overlay" aria-hidden="true"></div>
      </div>

      <!-- Luxurious Signature Narrative -->
      <div class="gallery-narrative reveal-up">
        <p class="narrative-quote">“Crafting legacies of gold and diamonds, designed to be passed down through generations.”</p>
        <p class="narrative-description">Explore our bespoke gallery of masterfully crafted bridal sets, certified solitaires, and antique gold heirlooms, each embodying the rich heritage of Mehsanawala artisanry.</p>
      </div>

      <!-- Magnetic Accent CTA Link -->
      <div class="gallery-cta-row reveal-up reveal-delay-3">
        <a href="<%= home.gallery.cta.href %>" class="gallery-cta btn--magnetic" id="gallery-cta-btn">
          <span class="gallery-cta__text"><%= home.gallery.cta.label %></span>
          <span class="gallery-cta__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M4 10H16M10 4l6 6-6 6" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="gallery-cta__underline" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>
