<section class="section home-social scroll-section" id="social">
  <div class="home-section-divider container" aria-hidden="true"></div>
  <div class="container">
    <header class="section-header reveal-blur">
      <span class="section-eyebrow"><%= home.social.eyebrow %></span>
      <h2><%= home.social.title %></h2>
      <p class="home-social__handle reveal-scale"><%= home.social.handle %></p>
    </header>
    <div class="social-grid stagger-group" data-stagger="110">
      <% home.social.images.forEach(function(src, i) { %>
        <a href="#" class="social-grid__item" aria-label="Instagram post <%= i + 1 %>">
          <img src="<%= src %>" alt="Patel Jewellers social gallery <%= i + 1 %>" loading="lazy" width="300" height="300">
          <span class="social-grid__hover" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </span>
        </a>
      <% }); %>
    </div>
  </div>
</section>
