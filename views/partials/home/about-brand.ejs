<section class="section home-about scroll-section" id="about-brand">
  <div class="home-section-divider container" aria-hidden="true"></div>
  <div class="container home-about__grid">
    <div class="home-about__media">
      <div class="home-about__img-frame img-fly" data-fly="far" data-parallax="soft">
        <img src="<%= home.about.image %>" alt="Patel Jewellers heritage craftsmanship" loading="lazy" width="600" height="700">
      </div>
    </div>
    <div class="home-about__content reveal-right">
      <span class="section-eyebrow"><%= home.about.eyebrow %></span>
      <h2><%= home.about.title %></h2>
      <% home.about.paragraphs.forEach(function(p, i) { %>
        <p class="reveal-up" style="--delay: <%= i * 60 %>ms"><%= p %></p>
      <% }); %>
      <a href="<%= home.about.cta.href %>" class="btn btn--outline btn--magnetic reveal-up reveal-delay-2"><%= home.about.cta.label %></a>
    </div>
  </div>
</section>
