<section class="section home-about" id="about-brand">
  <div class="container home-about__grid">
    <div class="home-about__media reveal-left">
      <div class="home-about__img-frame">
        <img src="<%= home.about.image %>" alt="Patel Jewellers heritage craftsmanship" loading="lazy" width="600" height="700">
      </div>
    </div>
    <div class="home-about__content reveal-right">
      <span class="section-eyebrow"><%= home.about.eyebrow %></span>
      <h2><%= home.about.title %></h2>
      <% home.about.paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
      <a href="<%= home.about.cta.href %>" class="btn btn--outline"><%= home.about.cta.label %></a>
    </div>
  </div>
</section>
