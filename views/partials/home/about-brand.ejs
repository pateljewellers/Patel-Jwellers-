<!-- ===== BRAND STORY & HERITAGE — VENETIAN SPA EDITORIAL STYLE ===== -->
<section class="hs-brand" id="about-brand" aria-label="Brand Story & Heritage">


  <div class="hs-brand__inner container">

    <!-- LEFT COLUMN: Vertical rotated label (Venetian-style side text) -->
    <div class="hs-brand__side-label" aria-hidden="true">
      <span class="hs-brand__vertical-text">PATEL JEWELLERS</span>
      <span class="hs-brand__vertical-line"></span>
    </div>

    <!-- CENTER COLUMN: Content block -->
    <div class="hs-brand__content">

      <!-- Eyebrow line -->
      <div class="hs-brand__eyebrow hs-reveal hs-reveal--fade-up" data-delay="0">
        <span class="hs-brand__eyebrow-dot"></span>
        <span class="hs-brand__eyebrow-text">About the Brand</span>
        <span class="hs-brand__eyebrow-rule"></span>
      </div>

      <!-- Main editorial title — each word animates in separately -->
      <h2 class="hs-brand__title">
        <span class="hs-brand__title-line hs-reveal hs-reveal--slide-up" data-delay="80">Brand</span>
        <span class="hs-brand__title-line hs-reveal hs-reveal--slide-up" data-delay="160">Story</span>
        <span class="hs-brand__title-line hs-brand__title-line--gold hs-reveal hs-reveal--slide-up" data-delay="240">&amp; Heritage</span>
      </h2>

      <!-- Stats row -->
      <div class="hs-brand__stats hs-reveal hs-reveal--fade-up" data-delay="320">
        <div class="hs-brand__stat">
          <span class="hs-brand__stat-num hs-counter" data-target="50">0</span><span class="hs-brand__stat-sup">+</span>
          <span class="hs-brand__stat-label">Years of Legacy</span>
        </div>
        <div class="hs-brand__stat-sep" aria-hidden="true"></div>
        <div class="hs-brand__stat">
          <span class="hs-brand__stat-num hs-counter" data-target="10000">0</span><span class="hs-brand__stat-sup">+</span>
          <span class="hs-brand__stat-label">Happy Families</span>
        </div>
        <div class="hs-brand__stat-sep" aria-hidden="true"></div>
        <div class="hs-brand__stat">
          <span class="hs-brand__stat-num hs-counter" data-target="100">0</span><span class="hs-brand__stat-sup">%</span>
          <span class="hs-brand__stat-label">Hallmark Certified</span>
        </div>
      </div>

      <!-- Body paragraphs -->
      <div class="hs-brand__body">
        <% home.about.paragraphs.forEach(function(p, i) { %>
          <p class="hs-brand__para hs-reveal hs-reveal--fade-up" data-delay="<%= 400 + i * 100 %>"><%= p %></p>
        <% }); %>
      </div>

      <!-- Quote accent -->
      <blockquote class="hs-brand__quote hs-reveal hs-reveal--fade-up" data-delay="680">
        <span class="hs-brand__quote-mark">"</span>
        <span class="hs-brand__quote-text">Crafted with love, worn through generations.</span>
      </blockquote>

      <!-- CTA -->
      <div class="hs-brand__cta-row hs-reveal hs-reveal--fade-up" data-delay="760">
        <a href="<%= home.about.cta.href %>" class="hs-brand__cta" id="about-cta-btn">
          <span class="hs-brand__cta-label"><%= home.about.cta.label %></span>
          <span class="hs-brand__cta-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- RIGHT COLUMN: floating stats card + image accent -->
    <div class="hs-brand__visual hs-reveal hs-reveal--fade-left" data-delay="200">
      <!-- Floating heritage badge -->
      <div class="hs-brand__badge">
        <div class="hs-brand__badge-ring" aria-hidden="true"></div>
        <span class="hs-brand__badge-since">Since</span>
        <span class="hs-brand__badge-year">1970s</span>
        <span class="hs-brand__badge-sub">Mehsana, Gujarat</span>
      </div>

      <!-- Slim vertical accent image strip -->
      <div class="hs-brand__img-strip">
        <img src="/images/about/model-hero.jpg" alt="Patel Jewellers bridal heritage model" loading="lazy">
        <div class="hs-brand__img-strip-caption">
          <span>Bridal Heritage</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom gold rule -->
  <div class="hs-brand__bottom-rule" aria-hidden="true"></div>

</section>
