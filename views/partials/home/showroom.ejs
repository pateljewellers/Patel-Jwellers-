<section class="section home-showroom" id="showroom">
  <div class="container home-showroom__grid">
    <div class="home-showroom__media reveal-left">
      <img src="<%= home.showroom.image %>" alt="Patel Jewellers luxury showroom" loading="lazy" width="640" height="480">
    </div>
    <div class="home-showroom__content reveal-right">
      <span class="section-eyebrow"><%= home.showroom.eyebrow %></span>
      <h2><%= home.showroom.title %></h2>
      <ul class="showroom-features">
        <% home.showroom.features.forEach(function(f) { %>
          <li><%= f %></li>
        <% }); %>
      </ul>
      <a href="<%= home.showroom.cta.href %>" class="btn btn--primary"><%= home.showroom.cta.label %></a>
    </div>
  </div>
</section>
