<section class="section home-showroom scroll-section" id="showroom" aria-labelledby="showroom-title">
  <!-- Glowing Canvas Particle Backdrop -->
  <canvas class="showroom-canvas" id="showroom-canvas" aria-hidden="true"></canvas>

  <!-- Ambient Light Gradients and slow-rotating elements -->
  <div class="showroom-ambient-glow" aria-hidden="true"></div>
  <div class="showroom-mandala-wrap" aria-hidden="true">
    <div class="showroom-mandala"></div>
  </div>

  <div class="container home-showroom__grid">
    <!-- Left Column: 3D Arched Palace Showroom Showcase -->
    <div class="home-showroom__visual">
      <!-- Pulsing decorative rings in background -->
      <div class="showroom-deco-rings" aria-hidden="true">
        <div class="deco-ring deco-ring--1"></div>
        <div class="deco-ring deco-ring--2"></div>
      </div>
      
      <!-- 3D Interactive Archway Tilt Card -->
      <div class="showroom-arch-card-wrap">
        <div class="showroom-arch-card" id="showroom-arch-card">
          <div class="showroom-arch-frame">
            <div class="showroom-arch-inner">
              <img src="<%= home.showroom.image %>" alt="Patel Jewellers Mehsanawala luxury showroom entrance" loading="lazy" width="600" height="750" class="showroom-main-img">
              <div class="showroom-glass-overlay"></div>
              
              <!-- Elegant brass corner filigrees -->
              <div class="showroom-filigree filigree--top-left" aria-hidden="true"></div>
              <div class="showroom-filigree filigree--top-right" aria-hidden="true"></div>
            </div>
          </div>
          <!-- Hanging premium badge -->
          <div class="showroom-tag" aria-hidden="true">
            <span class="showroom-tag__text">Est. 1990</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Exquisite Copy & 2x2 Feature Grid -->
    <div class="home-showroom__content reveal-right">
      <span class="section-eyebrow"><%= home.showroom.eyebrow %></span>
      <h2 id="showroom-title" class="showroom-heading">
        Experience The <span class="gold-gradient-text">Showroom</span>
      </h2>
      <p class="showroom-lead">
        Step into a realm where royalty meets craftsmanship. Our flagship sanctuary in Mehsana is designed to offer an unforgettable private shopping journey.
      </p>

      <!-- 2x2 Interactive Feature Grid -->
      <div class="showroom-features-grid stagger-group" data-stagger="120">
        <% home.showroom.features.forEach(function(feat, i) { %>
          <div class="showroom-feat-card reveal-up" style="--stagger-index: <%= i %>">
            <div class="showroom-feat-card__icon-box">
              <div class="icon-glow"></div>
              <% if (feat.icon === 'crown') { %>
                <!-- Crown SVG -->
                <svg viewBox="0 0 24 24" class="showroom-feat-icon" aria-hidden="true">
                  <path d="M12 2L4.5 9.5l3 3L12 8l4.5 4.5 3-3L12 2zm9 10h-2v7H5v-7H3v9h18v-9zm-16 2h14v1H5v-1zm0 3h14v1H5v-1z" fill="currentColor"/>
                </svg>
              <% } else if (feat.icon === 'gem') { %>
                <!-- Gem SVG -->
                <svg viewBox="0 0 24 24" class="showroom-feat-icon" aria-hidden="true">
                  <path d="M12 2L3 9l9 13 9-13-9-7zm0 3.2L18.2 10 12 19 5.8 10 12 5.2z" fill="currentColor"/>
                </svg>
              <% } else if (feat.icon === 'award') { %>
                <!-- Award SVG -->
                <svg viewBox="0 0 24 24" class="showroom-feat-icon" aria-hidden="true">
                  <path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm0 18.9c-3.9-1.2-6-5-6-9V6.8l6-2.7 6 2.7V11c0 4-2.1 7.8-6 9.1z" fill="currentColor"/>
                </svg>
              <% } else if (feat.icon === 'temple') { %>
                <!-- Temple/Arch SVG -->
                <svg viewBox="0 0 24 24" class="showroom-feat-icon" aria-hidden="true">
                  <path d="M12 2L1 7v3h2v11h3v-11h4v11h4v-11h4v11h3v-11h2V7L12 2zm8 17H4v-7h16v7z" fill="currentColor"/>
                </svg>
              <% } %>
            </div>
            <div class="showroom-feat-card__info">
              <h3><%= feat.title %></h3>
              <p><%= feat.desc %></p>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Magnetic Call-to-Action -->
      <div class="showroom-cta-wrap reveal-scale">
        <a href="<%= home.showroom.cta.href %>" class="btn btn--primary btn--magnetic showroom-cta-btn" id="showroom-cta-btn">
          <span><%= home.showroom.cta.label %></span>
          <svg viewBox="0 0 24 24" class="btn-arrow" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
