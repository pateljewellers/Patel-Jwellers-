<section class="home-hero hero-interactive-container" id="home-hero">
  <!-- Glowing Background Ambient Orbs -->
  <div class="glow-orb glow-orb--burgundy" aria-hidden="true"></div>
  <div class="glow-orb glow-orb--gold" aria-hidden="true"></div>
  
  <!-- Interactive Particles Canvas -->
  <canvas class="hero-interactive-canvas" id="hero-interactive-canvas"></canvas>

  <!-- Floating Parallax Luxury Elements (Abstract Rings & Diamonds) -->
  <div class="parallax-rings-container" aria-hidden="true">
    <svg class="parallax-ring parallax-ring--outer" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="50" r="48" stroke="rgba(176, 168, 154, 0.08)" stroke-width="0.75" stroke-dasharray="4 6" />
      <circle cx="50" cy="50" r="40" stroke="rgba(155, 27, 42, 0.06)" stroke-width="0.5" />
    </svg>
    <svg class="parallax-ring parallax-ring--inner" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="50" r="32" stroke="rgba(176, 168, 154, 0.12)" stroke-width="1.25" />
      <circle cx="50" cy="50" r="30" stroke="rgba(255, 255, 255, 0.03)" stroke-width="0.5" stroke-dasharray="10 4" />
      <path d="M 50 14 A 36 36 0 0 1 86 50" stroke="rgba(176, 168, 154, 0.25)" stroke-width="0.75" />
    </svg>
    
    <!-- Floating 3D Wireframe Diamonds -->
    <svg class="floating-diamond floating-diamond--1" viewBox="0 0 60 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M30 5 L55 30 L30 75 L5 30 Z" stroke="rgba(176, 168, 154, 0.12)" stroke-width="0.8" />
      <path d="M30 5 L30 75" stroke="rgba(176, 168, 154, 0.06)" stroke-width="0.5" />
      <path d="M5 30 L55 30" stroke="rgba(176, 168, 154, 0.06)" stroke-width="0.5" />
      <path d="M30 5 L18 30 L30 75 L42 30 Z" stroke="rgba(176, 168, 154, 0.06)" stroke-width="0.5" />
    </svg>
    <svg class="floating-diamond floating-diamond--2" viewBox="0 0 60 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M30 5 L55 30 L30 75 L5 30 Z" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.7" />
      <path d="M30 5 L30 75" stroke="rgba(255, 255, 255, 0.04)" stroke-width="0.4" />
      <path d="M5 30 L55 30" stroke="rgba(255, 255, 255, 0.04)" stroke-width="0.4" />
    </svg>
    <svg class="floating-diamond floating-diamond--3" viewBox="0 0 60 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M30 5 L55 30 L30 75 L5 30 Z" stroke="rgba(155, 27, 42, 0.15)" stroke-width="0.8" />
      <path d="M30 5 L18 30 L30 75 L42 30 Z" stroke="rgba(155, 27, 42, 0.08)" stroke-width="0.5" />
    </svg>
  </div>

  <!-- Hero Main Content Layout -->
  <div class="home-hero__content container">
    <span class="home-hero__eyebrow reveal-blur"><%= home.hero.eyebrow %></span>
    <h1 class="home-hero__title reveal-up reveal-delay-1"><%= home.hero.title %></h1>
    <p class="home-hero__tagline reveal-up reveal-delay-2"><%= home.hero.tagline %></p>
    <div class="home-hero__actions reveal-up reveal-delay-3">
      <a href="<%= home.hero.cta.href %>" class="btn btn--primary btn--magnetic btn--glow-gold">
        <%= home.hero.cta.label %>
        <span class="btn__arrow">→</span>
      </a>
    </div>
  </div>

  <!-- Interactive Luxury Collections Navigation Tags (Theme-Shift Triggers) -->
  <div class="hero-quicktags reveal-up reveal-delay-4">
    <div class="container">
      <span class="hero-quicktags__label">Explore Masterpieces</span>
      <div class="hero-quicktags__list">
        <a href="/collection" class="hero-tag-link" data-theme="gold">Gold</a>
        <a href="/collection" class="hero-tag-link" data-theme="ruby">Bridal</a>
        <a href="/collection" class="hero-tag-link" data-theme="diamond">Diamonds</a>
        <a href="/collection" class="hero-tag-link" data-theme="antique">Antique</a>
      </div>
    </div>
  </div>

  <!-- Interactive Scroll Down Hint -->
  <div class="home-hero__scroll-hint" aria-hidden="true">
    <span class="home-hero__scroll-text">Discover Heritage</span>
    <span class="home-hero__scroll-line"></span>
  </div>
</section>

<!-- Smooth dark-to-light brand story transition block -->
<section class="home-intro scroll-section bg-dark-transition">
  <div class="container home-intro__inner reveal-scale">
    <h2 class="home-intro__tagline"><%= home.hero.tagline %></h2>
    <p class="home-intro__desc reveal-up reveal-delay-1">Exquisite gold, certified diamonds & bridal masterpieces — crafted in Mehsana for generations.</p>
    <a href="<%= home.hero.cta.href %>" class="btn btn--primary btn--magnetic reveal-up reveal-delay-2"><%= home.hero.cta.label %></a>
  </div>
</section>
