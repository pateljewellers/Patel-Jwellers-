<section class="home-hero hero-interactive-container" id="home-hero">
  <!-- Glowing Background Ambient Orbs -->
  <div class="glow-orb glow-orb--burgundy" aria-hidden="true"></div>
  <div class="glow-orb glow-orb--gold" aria-hidden="true"></div>
  
  <!-- Interactive Particles Canvas -->
  <canvas class="hero-interactive-canvas" id="hero-interactive-canvas"></canvas>

  <!-- Hero Main Content -->
  <div class="container hero-grid-wrapper">
    <div class="home-hero__content">
      <span class="home-hero__eyebrow reveal-blur"><%= home.hero.eyebrow %></span>
      <h1 class="home-hero__title reveal-up reveal-delay-1"><%= home.hero.title %></h1>
      <p class="home-hero__tagline reveal-up reveal-delay-2"><%= home.hero.tagline %></p>
      <div class="home-hero__actions reveal-up reveal-delay-3">
        <a href="<%= home.hero.cta.href %>" class="btn btn--primary btn--magnetic btn--glow-gold">
          <%= home.hero.cta.label %>
          <span class="btn__arrow">→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Interactive Luxury Collections Navigation Tags (Theme-Shift Triggers) -->
  <div class="hero-quicktags reveal-up reveal-delay-4">
    <div class="container">
      <span class="hero-quicktags__label">Explore Masterpieces</span>
      <div class="hero-quicktags__list">
        <a href="/collection" class="hero-tag-link" data-theme="gold">Gold</a>
        <a href="/collection" class="hero-tag-link" data-theme="ruby">Bridal</a>
        <a href="/collection" class="hero-tag-link" data-theme="diamond">Diamonds</a>
        <a href="/collection" class="hero-tag-link" data-theme="antique">Antique</a>
      </div>
    </div>
  </div>

  <!-- Interactive Scroll Down Hint -->
  <div class="home-hero__scroll-hint" aria-hidden="true">
    <span class="home-hero__scroll-text">Discover Heritage</span>
    <span class="home-hero__scroll-line"></span>
  </div>
</section>

