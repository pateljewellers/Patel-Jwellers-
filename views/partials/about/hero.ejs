<section class="about-hero scroll-section" id="about-hero">
  <div class="container about-hero__inner">
    <div class="about-hero__content reveal-right">
      <span class="section-eyebrow section-eyebrow--light"><%= about.hero.eyebrow %></span>
      <h1><%= about.hero.title %></h1>
      <p><%= about.hero.description %></p>
      <a href="<%= about.hero.cta.href %>" class="btn btn--primary btn--magnetic reveal-up reveal-delay-1"><%= about.hero.cta.label %></a>
    </div>
    <div class="about-hero__media reveal-left">
      <img src="<%= about.hero.image %>" alt="About Patel Jewellers" loading="eager" width="1200" height="900">
    </div>
  </div>
</section>
