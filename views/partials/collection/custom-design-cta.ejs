<section class="section custom-design-cta scroll-section" id="collection-custom-design">
  <div class="container custom-design-cta__panel reveal-up">
    <div class="custom-design-cta__copy">
      <span class="section-eyebrow"><%= collection.customDesignCTA.eyebrow %></span>
      <h2><%= collection.customDesignCTA.title %></h2>
      <p><%= collection.customDesignCTA.description %></p>
    </div>
    <a href="<%= collection.customDesignCTA.cta.href %>" class="btn btn--primary btn--magnetic"><%= collection.customDesignCTA.cta.label %></a>
  </div>
</section>
