<section class="section collection-filters scroll-section" id="collection-filters">
  <div class="container">
    <div class="collection-filters__panel reveal-up">
      <div class="collection-filters__heading">
        <span class="section-eyebrow">Shop by Category</span>
        <h2>Select the collection you want to explore</h2>
      </div>
      <div class="collection-filters__list">
        <% collection.filters.forEach(function(filter) { %>
          <a href="/collection?category=<%= filter.id %>" class="category-pill <%= selectedCategory === filter.id ? 'is-active' : '' %>"><%= filter.label %></a>
        <% }); %>
      </div>
    </div>
  </div>
</section>
